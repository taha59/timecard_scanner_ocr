# Backend runtime settings. Enter these in Render's Environment settings.
# Flask does not load this file automatically; use the dashboard or exported env.
APP_ENV=production
ALLOWED_ORIGINS=https://your-app.vercel.app
# Replace with a random secret of at least 24 characters. Never put in VITE_*.
APP_ACCESS_TOKEN=replace-with-a-long-random-password
ENABLE_SERVER_OCR=false
# Docker sets RAPIDOCR_MODEL_DIR=/opt/models/rapidocr automatically.
