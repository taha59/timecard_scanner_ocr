# Public build-time settings. Enter these in Vercel's Environment Variables UI.
# Render origin only, with no /api suffix. Leave empty for same-origin local use.
VITE_API_BASE_URL=https://your-api.onrender.com
VITE_ENABLE_SERVER_OCR=false

# Maximum WASM CPU threads within one OCR worker (1, 2, or 4; default 4).
# Actual threads are capped by reported CPU count; unsupported browsers use one.
VITE_OCR_THREADS=4
